# Configurações para produção no EasyPanel

# Variáveis de ambiente recomendadas
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# Configurações da aplicação
HOST=0.0.0.0
PORT=8000

# Configurações de segurança
# (Adicione aqui suas configurações específicas se necessário)

# Rate limiting (implementar se necessário)
# MAX_REQUESTS_PER_MINUTE=100

# Timeout configurações
# REQUEST_TIMEOUT=30

# Logging level para produção
LOG_LEVEL=INFO